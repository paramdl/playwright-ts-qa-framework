{
  "name": "playwright-ts-qa-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI and API test framework against public demo apps",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/html"
  },
  "license": "MIT",
  "author": "Prashanth DL",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
